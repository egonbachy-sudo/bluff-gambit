{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "skipLibCheck": true
  },
  "include": ["shared", "server", "client"],
  "exclude": ["client/dist"]
}
